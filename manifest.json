{
  "manifest_version": 3,
  "name": "Missing Hanabi Variant Finder",
  "version": "1.0.0",
  "description": "Find and suggest missing Hanabi variants for your pregame lobby",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://hanab.live/*"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://hanab.live/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["chatCommandInjection.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
